<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HotReload</AssemblyName>
    <RootNamespace>RoundsHotReload</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/HotReload</PathMap>
    <!-- same bytes whether built here or inside a git checkout (no commit hash or SourceLink) -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/ROUNDS</GameDir>
    <Managed Condition="'$(Managed)' == ''">$(GameDir)/ROUNDS.app/Contents/Resources/Data/Managed</Managed>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/Mono.Cecil.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/MonoMod.Utils.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(Managed)/netstandard.dll" Private="false" />
  </ItemGroup>
  <!-- dotnet build -c Release -p:Deploy=true : copy into the game's BepInEx/plugins (takes effect next launch). -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <ItemGroup><Out Include="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).pdb" /></ItemGroup>
    <Copy SourceFiles="@(Out)" DestinationFolder="$(GameDir)/BepInEx/plugins/HotReload" />
  </Target>
</Project>
