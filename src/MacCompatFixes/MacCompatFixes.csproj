<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MacCompatFixes</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir>$(HOME)/Library/Application Support/Steam/steamapps/common/ROUNDS</GameDir>
    <Managed>$(GameDir)/ROUNDS.app/Contents/Resources/Data/Managed</Managed>
    <DebugType>portable</DebugType>
    <PackDir>$(MSBuildThisFileDirectory)../../pack/BepInEx/scripts</PackDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/Unity.Localization.dll" Private="false" />
    <Reference Include="$(Managed)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(Managed)/netstandard.dll" Private="false" />
  </ItemGroup>
  <!-- dotnet build -c Release -p:Deploy=true : copy into the running game's BepInEx/scripts (ScriptEngine
       hot-reloads it) and into the modpack. Plain builds don't touch the game. -->
  <Target Name="DeployScripts" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <ItemGroup><Out Include="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).pdb" /></ItemGroup>
    <Copy SourceFiles="@(Out)" DestinationFolder="$(GameDir)/BepInEx/scripts" />
    <Copy SourceFiles="@(Out)" DestinationFolder="$(PackDir)" />
  </Target>
</Project>
