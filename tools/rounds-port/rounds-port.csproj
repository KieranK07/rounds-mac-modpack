<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>rounds-port</AssemblyName>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PathMap>$(MSBuildProjectDirectory)=/_/rounds-port</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- tools/compathelpers, prebuilt so building this doesn't need the game; its methods get cloned into fixed mods -->
    <EmbeddedResource Include="helpers/compathelpers.dll" LogicalName="compathelpers.dll" />
  </ItemGroup>
</Project>
